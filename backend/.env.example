# Copy to backend/.env and fill in. Never commit backend/.env.
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1

# Must support tool calling. Run `python llm.py` to list models and test.
WORKER_MODEL=minimax-m3.1-flash
SHADOW_MODEL=minimax-m3.1-flash
JUDGE_MODEL=glm-5.3-flash
