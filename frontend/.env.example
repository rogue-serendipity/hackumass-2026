# Copy to .env.local. All optional.

# Backend base URL (default http://localhost:8000)
NEXT_PUBLIC_API_BASE=http://localhost:8000

# 1 = serve everything from the in-browser mock (lib/mock.ts), no backend needed
NEXT_PUBLIC_USE_MOCK=0

# USD per million tokens, for the Metrics tab's estimated cost. Leave unset to hide it.
NEXT_PUBLIC_PRICE_IN_PER_M=
NEXT_PUBLIC_PRICE_OUT_PER_M=
